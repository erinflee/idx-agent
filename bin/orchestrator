#!/usr/bin/env bash
# Wrapper so OpenClaw invokes one stable, allowlistable command.
# Runs the orchestrator CLI from the repo root (where .env + node_modules live).
# $0 is this script's path -> dirname/.. resolves the repo root on any machine.
# NOTE: search hits MySQL directly; market/knowledge/recommend routes also need
# the FastAPI service running (uvicorn service:app --reload).
cd "$(dirname "$0")/.." || exit 1
exec npx tsx skills/orchestrator/orchestrator.cli.ts "$@"
