{
  "name": "nlp-internship-skills",
  "private": true,
  "type": "module",
  "description": "TypeScript OpenClaw skills for the MLS assistant (parser tests run via tsx).",
  "scripts": {
    "test": "sh scripts/test-all.sh",
    "test-property-parse": "tsx skills/propertySearch/parse.test.ts",
    "test-property-search": "npx tsx skills/propertySearch/search.test.ts",
    "test-property-format": "npx tsx skills/propertySearch/format.test.ts",
    "test-property-index": "npx tsx skills/propertySearch/index.test.ts",
    "test-property-session": "npx tsx skills/propertySearch/session.test.ts",
    "test-property-conversation": "npx tsx skills/propertySearch/conversation.test.ts",
    "test-market-comps": "npx tsx skills/marketComps/comps.test.ts",
    "test-market-format": "npx tsx skills/marketComps/format.test.ts",
    "test-market-stats": "npx tsx skills/marketComps/marketStats.test.ts",
    "test-semantic-search": "npx tsx skills/semanticSearch/semanticSearch.test.ts",
    "test-semantic-format": "npx tsx skills/semanticSearch/format.test.ts",
    "test-recommend-format": "npx tsx skills/recommendations/format.test.ts",
    "test-rag-format": "npx tsx skills/rag/format.test.ts",
    "test-orchestrator": "npx tsx skills/orchestrator/orchestrator.test.ts",
    "demo-conversation": "npx tsx skills/propertySearch/conversation.cli.ts",
    "demo-market": "npx tsx skills/marketComps/marketStats.cli.ts",
    "demo-semantic": "npx tsx skills/semanticSearch/semanticSearch.cli.ts",
    "demo-recommend": "npx tsx skills/recommendations/recommend.cli.ts",
    "demo-rag": "npx tsx skills/rag/rag.cli.ts",
    "demo-orchestrator": "npx tsx skills/orchestrator/orchestrator.cli.ts"
